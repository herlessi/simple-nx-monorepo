# Banco (docker-compose.yml)
DATABASE_URL=postgresql://shop:shop@localhost:5433/shop?schema=public

# API (NestJS)
PORT=3000
WEB_ORIGIN=http://localhost:4200

# Web (Next.js)
# URL usada pelos Server Components (servidor Next -> API)
API_URL=http://localhost:3000/api
# URL usada pelo browser (Client Components -> API)
NEXT_PUBLIC_API_URL=http://localhost:3000/api
